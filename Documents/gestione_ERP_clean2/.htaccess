Options -MultiViews
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L]

# Aggiungi questa regola per gestire le rotte del tuo framework
#RewriteCond %{REQUEST_FILENAME} !-f
#RewriteCond %{REQUEST_FILENAME} !-d
#RewriteRule ^users/([0-9]+)$ index.php?page=users&id=$1 [QSA,L]

# Aumenta i limiti per l'upload dei file
<IfModule mod_php7.c>
    php_value upload_max_filesize 40M
    php_value post_max_size 45M
    php_value memory_limit 256M
    php_value max_execution_time 300
    php_value max_input_time 300
</IfModule>
<IfModule mod_php.c> # Per PHP 8+ o altre configurazioni
    php_value upload_max_filesize 40M
    php_value post_max_size 45M
    php_value memory_limit 256M
    php_value max_execution_time 300
    php_value max_input_time 300
</IfModule>
